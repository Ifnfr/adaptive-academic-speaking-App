# Copy this file to .env.local and fill in the keys for the providers you want to use.
# .env.local is read by Next.js automatically and must NOT be committed.
# Options: claude, gemini, deepseek, mock. Mock is local-only and requires no API key.
PODCHAT_AI_PROVIDER=Deepseek
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
PODCHAT_STT_PROVIDER=Deepgram
DEEPGRAM_API_KEY=

# Optional: override the Gemini model. Defaults to gemini-2.0-flash if unset.
# Examples: gemini-2.0-flash, gemini-2.5-flash, gemini-1.5-flash-latest
GEMINI_MODEL=gemini-2.0-flash

# Optional: override the DeepSeek model. Defaults to deepseek-chat if unset.
DEEPSEEK_MODEL=deepseek-chat

# Optional: Text-to-speech settings.
PODCHAT_TTS_PROVIDER=polly

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
POLLY_VOICE_ID=Brian
POLLY_ENGINE=neural

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5


# Optional: Clerk auth shell. Leave blank for local-only MVP usage.
# The publishable key is safe for browser use; the secret key must stay server-side.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: Supabase client setup for future cloud persistence adapters.
# The publishable key is safe only when Supabase RLS is enabled and tested.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
