# Copy this file to .env.local and fill in the keys for the providers you want to use.
# .env.local is read by Next.js automatically and must NOT be committed.
# Only one key is required at a time (matching the provider you select in the UI).

CLAUDE_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Optional: override the Gemini model. Defaults to gemini-2.0-flash if unset.
# Examples: gemini-2.0-flash, gemini-2.5-flash, gemini-1.5-flash-latest
GEMINI_MODEL=gemini-2.0-flash
