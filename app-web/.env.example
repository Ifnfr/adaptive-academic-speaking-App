# Copy this file to .env.local and fill in the keys for the providers you want to use.
# .env.local is read by Next.js automatically and must NOT be committed.

# =============================================================================
# APP / PUBLIC RUNTIME
# =============================================================================
# Set to production, development, or test
NODE_ENV=

# =============================================================================
# AUTHENTICATION — CLERK
# =============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# =============================================================================
# DATABASE — SUPABASE
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# AI PROVIDERS — GEMINI
# =============================================================================
GEMINI_API_KEY=
# Optional model override (e.g. gemini-2.0-flash, gemini-2.5-flash, gemini-1.5-flash-latest)
GEMINI_MODEL=gemini-2.0-flash

# =============================================================================
# AI PROVIDERS — CLAUDE / ANTHROPIC
# =============================================================================
CLAUDE_API_KEY=

# =============================================================================
# AI PROVIDERS — DEEPSEEK
# =============================================================================
DEEPSEEK_API_KEY=
# Optional model override (e.g. deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat

# =============================================================================
# AI PROVIDERS — MINIMAX
# =============================================================================
MINIMAX_API_KEY=
# Optional model override (e.g. MiniMax-M3)
MINIMAX_MODEL=MiniMax-M3
# Optional custom endpoint override (defaults to https://api.minimax.io/v1)
MINIMAX_BASE_URL=

# =============================================================================
# TTS — ELEVENLABS
# =============================================================================
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional model override used in E2E tests (e.g. eleven_flash_v2_5)
ELEVENLABS_MODEL_ID=

# =============================================================================
# TTS — AMAZON POLLY
# =============================================================================
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AMAZON_POLLY_DEFAULT_VOICE_PROFILE=british_female
AMAZON_POLLY_OUTPUT_FORMAT=mp3
AMAZON_POLLY_SAMPLE_RATE=24000

# =============================================================================
# STT / SPEECH-TO-TEXT
# =============================================================================
DEEPGRAM_API_KEY=

# =============================================================================
# FEATURE FLAGS / CONFIGURATION TOGGLES
# =============================================================================
# Active AI provider for Podchat: claude, gemini, deepseek, mock.
PODCHAT_AI_PROVIDER=Deepseek
# Active AI provider for Article Practice. Set to mock for local dev.
ARTICLE_AI_PROVIDER=
# Active STT provider for Podchat: deepgram, mock.
PODCHAT_STT_PROVIDER=Deepgram
# Active TTS provider for Podchat: amazon-polly, elevenlabs.
TTS_PROVIDER=amazon-polly

# Active provider for Pattern Drill roles: claude, deepseek, minimax_m3
AI_PLANNING_PROVIDER=claude
AI_EXECUTION_PROVIDER=deepseek

# =============================================================================
# TEST / QA
# =============================================================================
# Skip launching the dev server during Playwright execution if already running
PLAYWRIGHT_SKIP_WEB_SERVER=
